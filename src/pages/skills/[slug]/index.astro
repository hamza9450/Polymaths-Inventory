---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { fields, subheadings, resources } from '../../../data/resources.js';

export function getStaticPaths() {
  return fields.map(f => ({ params: { slug: f.slug } }));
}

const { slug } = Astro.params;
const field = fields.find(f => f.slug === slug);
const fieldResources = resources.filter(r => r.field === slug);
---
<BaseLayout title={field.name}>
  <div class="breadcrumb"><a href="/">Polymath's Inventory</a> / {field.name}</div>
  <h1 class="field-title">{field.name}</h1>

  {subheadings.map(heading => {
    const items = fieldResources.filter(r => r.subheading === heading);
    if (items.length === 0) return null;
    return (
      <section>
        <h2 class="subheading">{heading}</h2>
        <ul class="resource-list">
          {items.map(r => (
            <li>
              <span class="resource-name">{r.name}</span>
              <a class="resource-link" href={r.url} target="_blank" rel="noopener noreferrer">{r.linkText}</a>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
</BaseLayout>
