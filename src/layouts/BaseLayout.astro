---
import '../styles/global.css';
import { fields } from '../data/resources.js';
const { title } = Astro.props;
const pageTitle = title ? `${title} — Polymath's Inventory` : "Polymath's Inventory";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content="Free resources to learn any skill, organized by field." />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a href="/" class="brand">Polymath's Inventory</a>
      </div>
    </header>
    <div class="layout-shell">
      <nav class="sidebar">
        <ul class="sidebar-list">
          {fields.map(field => (
            <li><a href={`/skills/${field.slug}/`}>{field.name}</a></li>
          ))}
        </ul>
      </nav>
      <main class="main-content">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
    </footer>
  </body>
</html>
